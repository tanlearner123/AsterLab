    name: 2.5 uM Dox
    role: treatment
    technical_repeats: 3
  - id: g_d4
    name: 1.25 uM Dox
    role: treatment
    technical_repeats: 3
  - id: g_d5
    name: 0.625 uM Dox
    role: treatment
    technical_repeats: 3
  - id: g_d6
